# Supabase project URL. Wajib untuk koneksi aplikasi dan verifier.
# Ambil dari Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key saja; aman untuk browser dengan RLS aktif. Jangan gunakan service_role/secret key.
# Ambil dari Supabase Dashboard → Project Settings → API → Project API keys → anon/public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Akun A untuk verifier RLS (email akun uji khusus terkonfirmasi). Opsional, hanya untuk pengujian lokal.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=

# Akun B untuk verifier RLS (email akun uji khusus terkonfirmasi). Opsional, hanya untuk pengujian lokal.
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=

# Pengakuan eksplisit untuk verifier fixture akun uji. Isi dedicated-test-accounts hanya saat menjalankan tes dengan akun khusus.
RLS_TEST_ALLOW_FIXTURES=

# Base URL server aplikasi untuk verifier HTTP. Opsional; default http://127.0.0.1:3001.
RLS_TEST_APP_URL=

# Direktori output build Next.js. Opsional; default .next.
MYBUDGET_BUILD_DIR=

# Aktifkan mode build hemat memori bila bernilai 1. Opsional.
MYBUDGET_LOW_MEMORY=
